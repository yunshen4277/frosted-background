{
  "name": "frosted-background",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.10.0",
  "frostedBackgroundUpdates": {
    "repository": "yunshen4277/frosted-background"
  },
  "publisher": "local-frosted",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "background",
    "glass",
    "video",
    "wallpaper",
    "毛玻璃"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "node scripts/package.js"
  },
  "devDependencies": {
    "jszip": "3.10.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "frostedBackground.openPanel",
        "title": "%command.openPanel%",
        "category": "%extension.category%"
      },
      {
        "command": "frostedBackground.closePanel",
        "title": "%command.closePanel%",
        "category": "%extension.category%",
        "icon": "$(close)"
      },
      {
        "command": "frostedBackground.checkUpdates",
        "title": "%command.checkUpdates%",
        "category": "%extension.category%"
      },
      {
        "command": "frostedBackground.selectImage",
        "title": "%command.selectImage%",
        "category": "%extension.category%"
      },
      {
        "command": "frostedBackground.selectVideo",
        "title": "%command.selectVideo%",
        "category": "%extension.category%"
      },
      {
        "command": "frostedBackground.openSettings",
        "title": "%command.openSettings%",
        "category": "%extension.category%"
      },
      {
        "command": "frostedBackground.apply",
        "title": "%command.apply%",
        "category": "%extension.category%"
      },
      {
        "command": "frostedBackground.restore",
        "title": "%command.restore%",
        "category": "%extension.category%"
      },
      {
        "command": "frostedBackground.status",
        "title": "%command.status%",
        "category": "%extension.category%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "frostedBackground",
          "title": "%extension.category%",
          "icon": "media/background-icon.svg"
        }
      ]
    },
    "views": {
      "frostedBackground": [
        {
          "id": "frostedBackground.controls",
          "name": "%view.controls%",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "frostedBackground.closePanel",
          "when": "view == frostedBackground.controls",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "frostedBackground.selectImage",
          "when": "false"
        },
        {
          "command": "frostedBackground.selectVideo",
          "when": "false"
        },
        {
          "command": "frostedBackground.openSettings",
          "when": "false"
        },
        {
          "command": "frostedBackground.status",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%extension.category%",
      "properties": {
        "frostedBackground.paused": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "%setting.paused.description%"
        },
        "frostedBackground.regions": {
          "type": "object",
          "default": {
            "enabled": false,
            "items": []
          },
          "scope": "application",
          "description": "%setting.regions.description%",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "required": [
                  "points"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 40,
                    "pattern": "^[a-zA-Z0-9_-]+$"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "points": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 64,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  },
                  "feather": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.3,
                    "default": 0
                  },
                  "blur": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 60
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0.05,
                    "maximum": 1
                  },
                  "tintOpacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.9
                  },
                  "brightness": {
                    "type": "number",
                    "minimum": 0.2,
                    "maximum": 2
                  },
                  "saturation": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  }
                }
              }
            }
          }
        },
        "frostedBackground.updateMode": {
          "type": "string",
          "enum": [
            "automatic",
            "notify",
            "off"
          ],
          "enumDescriptions": [
            "%setting.updateMode.automatic%",
            "%setting.updateMode.notify%",
            "%setting.updateMode.off%"
          ],
          "default": "automatic",
          "scope": "application",
          "description": "%setting.updateMode.description%"
        },
        "frostedBackground.blur": {
          "type": "number",
          "default": 14,
          "minimum": 0,
          "maximum": 60,
          "scope": "application",
          "description": "%setting.blur.description%"
        },
        "frostedBackground.opacity": {
          "type": "number",
          "default": 0.35,
          "minimum": 0.05,
          "maximum": 1,
          "scope": "application",
          "description": "%setting.opacity.description%"
        },
        "frostedBackground.tintOpacity": {
          "type": "number",
          "default": 0.18,
          "minimum": 0,
          "maximum": 0.9,
          "scope": "application",
          "description": "%setting.tintOpacity.description%"
        },
        "frostedBackground.saturation": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 2,
          "scope": "application",
          "description": "%setting.saturation.description%"
        },
        "frostedBackground.brightness": {
          "type": "number",
          "default": 1,
          "minimum": 0.2,
          "maximum": 2,
          "scope": "application",
          "description": "%setting.brightness.description%"
        },
        "frostedBackground.fit": {
          "type": "string",
          "enum": [
            "cover",
            "contain",
            "fill"
          ],
          "enumDescriptions": [
            "%setting.fit.cover%",
            "%setting.fit.contain%",
            "%setting.fit.fill%"
          ],
          "default": "cover",
          "scope": "application",
          "description": "%setting.fit.description%"
        },
        "frostedBackground.position": {
          "type": "string",
          "enum": [
            "center center",
            "center top",
            "center bottom",
            "left center",
            "right center"
          ],
          "default": "center center",
          "scope": "application",
          "description": "%setting.position.description%",
          "enumDescriptions": [
            "%setting.position.center%",
            "%setting.position.top%",
            "%setting.position.bottom%",
            "%setting.position.left%",
            "%setting.position.right%"
          ]
        },
        "frostedBackground.playbackRate": {
          "type": "number",
          "default": 1,
          "minimum": 0.25,
          "maximum": 2,
          "scope": "application",
          "description": "%setting.playbackRate.description%"
        },
        "frostedBackground.pauseWhenUnfocused": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.pauseWhenUnfocused.description%"
        },
        "frostedBackground.respectReducedMotion": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.respectReducedMotion.description%"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yunshen4277/frosted-background.git"
  },
  "homepage": "https://github.com/yunshen4277/frosted-background#readme",
  "bugs": {
    "url": "https://github.com/yunshen4277/frosted-background/issues"
  }
}
